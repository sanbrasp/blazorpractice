@page "/catalog"
@using BlazorCrashCourse.Models
@using BlazorCrashCourse.Services
@inject ProductService Api
@inject CartState Cart

<h3>Catalog</h3>

<button class="add-btn" @onclick="AddMilk">+ Add milk</button>

@if (_products is null)
{
    <p>Loading products..</p>
}
else
{
    <div class="catalog-grid">
        @foreach (var p in _products)
        {
            <ProductCard Product="p"
                         OnAdd="() => Cart.Add()"
                         OnDelete="() => Delete(p.Id)"/>
        }
    </div>
}

@code {
    private List<Product>? _products;
    protected override async Task OnInitializedAsync()
    => _products = await Api.GetProductAsync();

    async Task AddMilk()
    {
        var milk = new Product
        {
            Name = "Milk",
            Price = 100,
            Category = "Groceries",
            Rating = new Rating { Rate = 5, Count = 1 }
        };
        var created = await Api.AddAsync(milk);
        _products?.Insert(0, created ?? milk);
    }

    async Task Delete(int id)
    {
        await Api.DeleteAsync(id);
        _products?.RemoveAll(p => p.Id == id);
    }
}